<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <receiver android:name=".NotificationProbe" android:exported="true">
            <intent-filter><action android:name="dev.glgra.launcher.PROBE_POST"/><action android:name="dev.glgra.launcher.PROBE_CLEAR"/><action android:name="dev.glgra.launcher.PROBE_ACTION"/></intent-filter>
        </receiver>
        <receiver android:name=".FixtureWidget" android:exported="true" android:label="Foundation test widget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/fixture_widget"/>
        </receiver>
        <activity android:name=".FixtureConfigActivity" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/></intent-filter>
        </activity>
    </application>
</manifest>
